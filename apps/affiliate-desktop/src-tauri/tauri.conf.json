{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Partnera Affiliate",
  "version": "0.1.3",
  "identifier": "com.partnera.affiliate",
  "build": {
    "beforeDevCommand": "pnpm prepare:build-info",
    "beforeBuildCommand": "pnpm prepare:build-info",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["default", "updater"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Partnera",
    "category": "Business",
    "shortDescription": "Partnera Affiliate — affiliate portal (thin client)",
    "longDescription": "Windows desktop thin client for the Partnera Affiliate portal. It loads the affiliate portal (/affiliate) from the central Partnera API over HTTPS — no bundled runtime and no local database. The central API is the single source of truth, and the server-side scope guard keeps each affiliate isolated to their own data. Affiliates only.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["resources/*"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzNjVFRTgwODczNzY1NjgKUldSb1pUZUhnTzVsazFrYkh2eWdVcjJFdzFKWTZiZlZBaFM4ZWM3UmdxQ1k5RnlCOHZySHFEZm0K",
      "endpoints": [
        "https://github.com/REPLACE_OWNER/REPLACE_REPO/releases/latest/download/affiliate-latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
