{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Partnera Internal OS",
  "version": "0.1.0",
  "identifier": "com.partnera.internal",
  "build": {
    "beforeDevCommand": "pnpm prepare:runtime",
    "beforeBuildCommand": "pnpm prepare:runtime",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Partnera",
    "category": "Business",
    "shortDescription": "Partnera Internal OS — private platform operations console",
    "longDescription": "Private Windows desktop wrapper for the Partnera Internal OS (platform operators only). Runs the existing admin panel inside a bundled local runtime on loopback; no public portals are included.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["resources/*"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
