{
  "name": "@partnera/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "tsc -b --clean",
    "bundle": "esbuild src/server.ts --bundle --platform=node --format=esm --jsx=automatic --outfile=dist/server.mjs --external:react --external:react-dom",
    "bundle:prod": "esbuild deploy/server-prod.ts --bundle --platform=node --format=esm --jsx=automatic --outfile=dist/server.mjs --external:react --external:react-dom --external:pg",
    "serve": "pnpm bundle && node dist/server.mjs"
  },
  "dependencies": {
    "@partnera/analytics": "workspace:*",
    "@partnera/application": "workspace:*",
    "@partnera/auth": "workspace:*",
    "@partnera/commission-engine": "workspace:*",
    "@partnera/core": "workspace:*",
    "@partnera/creator-marketplace": "workspace:*",
    "@partnera/fraud-engine": "workspace:*",
    "@partnera/notification-engine": "workspace:*",
    "@partnera/offer-engine": "workspace:*",
    "@partnera/payment-engine": "workspace:*",
    "@partnera/persistence": "workspace:*",
    "@partnera/platform": "workspace:*",
    "@partnera/platform-finance": "workspace:*",
    "@partnera/shopify": "workspace:*",
    "@partnera/tracking-engine": "workspace:*",
    "@partnera/ui": "workspace:*",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.21.5"
  }
}
