# Partnera — environment example (NO real secrets here; copy to .env and fill locally)
# Separate values per environment: development / test / production.

# --- Runtime ---
NODE_ENV=development            # development | test | production
PORT=4000
PARTNERA_HOST=127.0.0.1         # local host bind address (loopback by default; the
                                # desktop wrapper relies on this — do NOT expose on LAN)
LOG_LEVEL=info                  # debug | info | warn | error
LOG_FORMAT=pretty               # pretty (dev) | json (hosted)

# --- Persistence (explicit; NO silent fallback) ---
# memory  -> in-memory store + JSON snapshot (local dev/tests; no external services)
# postgres-> Prisma/Postgres store (staging/production). Requires DATABASE_URL.
PARTNERA_PERSISTENCE=memory
# Required only when PARTNERA_PERSISTENCE=postgres:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/partnera
PARTNERA_DATA=./.partnera/data.json   # memory mode: snapshot file location

# --- Shopify app (own app; NOT PrimeBuild's rewards app) ---
# Provided by the Shopify Partner dashboard; keep secret out of version control.
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,read_orders,read_customers
SHOPIFY_APP_URL=https://your-staging-host.example
SHOPIFY_AUTH_CALLBACK_URL=https://your-staging-host.example/api/auth/callback
SHOPIFY_API_VERSION=2024-10
# SHOPIFY_WEBHOOK_SECRET=            # if using a dedicated webhook signing secret

# --- Secrets management (references, not values) ---
# TOKEN_ENCRYPTION_KEY=              # encrypts offline access tokens at rest
# SESSION_SECRET=                    # signs app session cookies/state

# --- Feature flags (safe defaults; real money/AI/billing OFF outside production) ---
PARTNERA_REAL_PAYMENTS=false
PARTNERA_REAL_AI=false
PARTNERA_REAL_BILLING=false

# The startup env validator (see @partnera/shopify validateEnvironment +
# @partnera/persistence validatePersistenceConfig) REFUSES to start on unsafe or
# mixed configuration (e.g. NODE_ENV=production with PARTNERA_PERSISTENCE=memory,
# or postgres mode without DATABASE_URL, or real payments outside production).
